        eventTracker.trackClick('#free-games a', 'clickFreeToPlayGames');

        // YOU MAY ALSO LIKE APP CARDS
        eventTracker.trackClick('#related-apps .card-app', 'clickNewApp');

        // TRENDING CATEGORIES
        eventTracker.trackClick('#trending-categories-apps .card-category-cover__title', 'clickCategoryTopAppTitleModule');
        eventTracker.trackClick('#trending-categories-apps .card-category-cover__list .card-category-cover__link', 'clickCategoryTopAppModule');
        eventTracker.trackClick('#trending-categories-apps .card-category-cover__item--more .card-category-cover__link', 'clickCategoryTopAppShowMoreModule');
        eventTracker.trackClick('#trending-categories-apps .track-btn-base', 'clickCategoryTopAppGroupShowMoreModule');

        // APP SUPPORT LINK
        eventTracker.trackClick('#message-app-support a', 'clickSupportPage');

        // HUB LINK MODULE
        eventTracker.trackClick('#section-hub-link a', 'clickAppHubLink');

        eventTracker.trackEvent('fbPurchase', { appSlug: 'vlc-media-player', appTagSlug: 'multimedia' });
      });
    </script><div class="modal modal-brand js-rating-modal is-hidden"><div class="modal__overlay js-modal-window-overlay track-modal-window-overlay" data-auto="modal-window-overlay"></div><div class="modal__container modal__container--extralarge js-modal-window-container"><div class="modal__header"><div class="header-brand"><a title="Softonic" href="https://en.softonic.com" class="header-brand__home-button" data-auto="modal-window-home-button"><svg class="corporate-logo" viewBox="0 0 505 141" xmlns="http://www.w3.org/2000/svg"><title>Softonic</title><g class="corporate-logo__path" fill="#FFF" fill-rule="nonzero"><path d="M129.5 76c2.3-2.4 3-5.8 2-8.9-1.1-3.1-3.8-5.4-7-5.8l-28.6-4.1-12.7-25.7c-1.5-3-4.5-4.9-7.9-4.9-3.4 0-6.4 1.9-7.9 4.9L54.8 57.1l-28.3 4.1c-3.3.5-6 2.8-7.1 6-1 3.2-.2 6.6 2.2 9L42 96.1l-3.5 19c-.2 1.2.1 2.3.8 3.3.7 1 1.7 1.6 2.9 1.8 1.2.2 2.3-.1 3.3-.8 1-.7 1.6-1.7 1.8-2.9l3.5-19c.5-2.8-.5-5.8-2.5-7.8L27.9 69.9l28.2-4.1c2.9-.4 5.3-2.2 6.6-4.8l12.5-25.6L87.9 61c1.3 2.6 3.8 4.4 6.6 4.8l28.5 4.1-6.3 6.5c-16.3 16.6-40.2 33.9-64.1 46.3l-15.4 8c-17.8-12.6-28.5-33-28.5-54.8 0-6.8 1-13.6 3-20 .7-2.3-.6-4.8-2.9-5.5-1.1-.4-2.3-.2-3.4.3-1 .5-1.8 1.5-2.2 2.6-2 7.4-3.2 15-3.2 22.8 0 25.8 12.9 49.6 34.6 63.6l.2.1c.3.2.5.3.8.4.1 0 .2.1.3.1.4.1.8.2 1.2.2.7 0 1.4-.2 2-.5l17.7-9.3c24.6-12.8 49.4-30.7 66.3-48l6.4-6.7z"></path><path d="M75.8.3C70.1.3 64.5.9 59 2.2c-2.4.5-3.9 2.9-3.3 5.3.5 2.4 2.9 3.9 5.3 3.3 4.8-1.1 9.8-1.6 14.8-1.6 36.9 0 67 30 67 67 0 21.9-10.7 42.4-28.8 55l-20.5-10.6c-2.2-1.1-4.8-.3-6 1.8-1.1 2.2-.3 4.8 1.8 6l22.9 11.8.2.1c.2.1.5.3.8.3h.2c.3.1.6.1.9.1h.5v-.1c.2 0 .5-.1.7-.2.1 0 .2-.1.3-.1.2-.1.5-.2.8-.4l.1-.1c21.9-14 34.9-37.9 34.9-63.8 0-41.7-34-75.7-75.8-75.7zM28.5 44.9c11 0 19.9-8.9 19.9-19.9 0-11-8.9-19.9-19.9-19.9C17.5 5.1 8.6 14 8.6 25c0 10.9 8.9 19.9 19.9 19.9zm0-30.4c5.7 0 10.4 4.7 10.4 10.4s-4.7 10.4-10.4 10.4-10.4-4.7-10.4-10.4 4.6-10.4 10.4-10.4zM463.7 81.4c0-24.3 16.8-26.9 24.2-26.9 8.5 0 13.5 2.2 13.8 2.3h-.1c1.8 1 3.1 3.4 2.2 5.6-.8 2.3-