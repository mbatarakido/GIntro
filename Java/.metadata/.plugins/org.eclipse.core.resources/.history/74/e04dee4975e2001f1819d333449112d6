<%@ page import="com.mbata.Jspdemo" %>
<!DOCTYPE html>
<html>

<head>
    <meta charset="ISO-8859-1">
    <title>JSP</title>
</head>

<body>
    <jsp:include page="my-header.html"></jsp:include>
    Request user agent: <%=request.getHeader("User-Agent")%>
    <br><br>
   	Request language: <%=request.getLocale()%>
    <br><br>
    Today's Date is <%= new java.util.Date()%>!!!
    <br><br>
    <%
    	for(int i=1; i<=10; i++){
    		for(int j=1; j<=i; j++)
    			out.print("*");
    		out.println("<br>");
    	}
    %>
    <br><br>
    <%!
    String makeItLower(String data){
    	return data.toLowerCase();
    }
    %>
    Lower Case JAVA SERVER PAGES is <%=makeItLower("JAVA SERVER PAGES")%>
    <br><br>
    Have some fun: <%=Jspdemo.toUpper("fun fun fun!!!") %>

    
    <br>
    Student name : <%=request.getParameter("firstname") %> <%=request.getParameter("lastname") %>
    Student confirmed name : ${param.firstname} ${param.lastname}
    <br>
    <jsp:include page="my-footer.jsp"></jsp:include>
</body>

</html>