 <%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
 <%@ page import="java.util.*,com.mbata.Student" %>
 <%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>JSTL Tags - Student</title>
</head>
<%
	List<Student> data = new ArrayList<>();

	data.add(new Student("John","Simpson",false));
	data.add(new Student("Tobby","Sly",true));
	data.add(new Student("Mary","Anne",false));
	data.add(new Student("Wesley","Snipes",true));
	data.add(new Student("Nancy","Greene",false));
	
	pageContext.setAttribute("myStudents", data);
%>
<body>
	<table border=1>
		<tr>
			<th>First Name</th>
			<th>Last Name</th>
			<th>Gold Student</th>
			<th>Discount</th>
		</tr>		
		<c:forEach var="tempStudent" items="${myStudents}">
			<tr>
				<td>${tempStudent.firstname}</td> 
				<td>${tempStudent.lastname}</td> 
				<td>${tempStudent.goldCustomer}</td>
				<td>
					<c:choose>
						<c:when test="${not tempStudent.goldCustomer}">
						Normal
						</c:when>
						<c:otherwise test="${not tempStudent.goldCustomer}">
						Normal
						</c:otherwise>
					</c:choose>
				</td>
			</tr>			
		</c:forEach>
		
	</table>
</body>
</html>